---
layout: layouts/base.njk
---
<article class="post">
  <header class="post__header">
    <h1 class="post__title">{{ title }}</h1>
    <p class="post__meta">
      <time datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
      {% if tags %}
        <span class="post__tags" aria-label="Tags">
          {% for tag in tags %}
            {% if tag != "post" %}
              <span class="tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </span>
      {% endif %}
    </p>
    {% if description %}
      <p class="post__description">{{ description }}</p>
    {% endif %}
  </header>

  {% if versionOf %}
    <aside class="version-notice version-notice--archived" role="note">
      <p>You are viewing <strong>version {{ version }}</strong> of this post &mdash; this is not the current version. <a href="{{ versionOf }}">Read the current version &rarr;</a></p>
    </aside>
  {% else %}
    {% set olderVersions = collections.postVersions | versionsOf(page.url) %}
    {% if olderVersions.length %}
      <aside class="version-notice" role="note">
        <p>Earlier versions:
          {% for v in olderVersions %}
            <a href="{{ v.url }}">v{{ v.data.version }}</a>{% if not loop.last %}, {% endif %}
          {% endfor %}
        </p>
      </aside>
    {% endif %}
  {% endif %}

  <div class="post__body prose">
    {{ content | safe }}
  </div>
</article>
